{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "packages": {
    ".github/workflows": {
      "release-type": "simple",
      "component": "workflows"
    },
    "actions/generate-sbom": {
      "release-type": "simple",
      "component": "generate-sbom"
    },
    "actions/codeql": {
      "release-type": "simple",
      "component": "codeql"
    },
    "actions/node-build": {
      "release-type": "simple",
      "component": "node-build"
    },
    "actions/stale": {
      "release-type": "simple",
      "component": "stale"
    },
    "actions/release-checkout": {
      "release-type": "simple",
      "component": "release-checkout"
    },
    "actions/conventional-commits": {
      "release-type": "simple",
      "component": "conventional-commits"
    },
    "actions/claude-review": {
      "release-type": "simple",
      "component": "claude-review"
    },
    "actions/go-build": {
      "release-type": "simple",
      "component": "go-build"
    },
    "actions/release-commit": {
      "release-type": "simple",
      "component": "release-commit"
    }
  }
}
